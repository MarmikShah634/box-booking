# ── User Web (player app) — Next.js, port 3000 ───────────────────────────────
# Copy to .env.local and fill in values.
# NEXT_PUBLIC_* variables are inlined at build time and visible to the browser.
# Never put secrets here.

# Base URL of the backend API (no trailing slash, no /api/v1 suffix)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Razorpay Key ID used to initialise the Razorpay checkout JS in the browser.
# In production this should be the owner's Razorpay Key ID (which the backend
# also returns in the booking initiation response).
# Use a test key (rzp_test_*) for local development.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME

# Canonical public URL of this app — used for robots.txt generation.
# Optional. Defaults to https://boxcricket.in if not set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
