# ── Landing Page — Next.js, port 3003 ────────────────────────────────────────
# Copy to .env.local and fill in values.
# All variables are optional — the landing page falls back to default URLs.
# NEXT_PUBLIC_* variables are inlined at build time and visible to the browser.

# URL of the player-facing booking app (used in CTA buttons)
NEXT_PUBLIC_USER_APP_URL=http://localhost:3000

# URL of the owner portal (used in "Register as owner" CTA)
NEXT_PUBLIC_OWNER_APP_URL=http://localhost:3002/owner
