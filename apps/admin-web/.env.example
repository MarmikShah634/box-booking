# ── Admin Web (owner portal + super-admin dashboard) — Next.js, port 3002 ────
# Copy to .env.local and fill in values.
# NEXT_PUBLIC_* variables are inlined at build time and visible to the browser.
# Never put secrets here.

# Base URL of the backend API (no trailing slash, no /api/v1 suffix)
NEXT_PUBLIC_API_URL=http://localhost:3001
