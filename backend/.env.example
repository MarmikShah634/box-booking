# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
PUBLIC_API_URL=http://localhost:3001
PUBLIC_USER_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_WEB_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://boxcricket:boxcricket_dev@localhost:5433/boxcricket
DATABASE_POOL_MAX=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_dev_pass@localhost:6379

# ── Crypto ───────────────────────────────────────────────────────────────────
# Generate: openssl genrsa 2048 | base64 -w0
JWT_PRIVATE_KEY_BASE64=REPLACE_ME
# Generate: openssl rsa -pubout from above private key | base64 -w0
JWT_PUBLIC_KEY_BASE64=REPLACE_ME
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Generate: openssl rand -hex 32
ENCRYPTION_KEY_HEX=REPLACE_ME_64_HEX_CHARS
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# ── MSG91 ─────────────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=REPLACE_ME
MSG91_SENDER_ID=BOXCRK
MSG91_OTP_TEMPLATE_ID=REPLACE_ME
MSG91_BOOKING_CONFIRM_TEMPLATE_ID=REPLACE_ME
MSG91_REFUND_TEMPLATE_ID=REPLACE_ME

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=REPLACE_ME
RESEND_FROM=no-reply@example.com
RESEND_REPLY_TO=support@example.com

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=boxcricket-dev
R2_PUBLIC_BASE_URL=https://cdn.example.com
R2_PRESIGN_TTL_SECONDS=3600

# ── Razorpay (platform-level) ────────────────────────────────────────────────
RAZORPAY_PLATFORM_KEY_ID=REPLACE_ME
RAZORPAY_PLATFORM_KEY_SECRET=REPLACE_ME
RAZORPAY_PLATFORM_WEBHOOK_SECRET=REPLACE_ME

# ── Free mode ────────────────────────────────────────────────────────────────
PLATFORM_FREE_MODE=true
PLATFORM_FREE_MODE_REASON=Pre-launch

# ── Super-admin seed ─────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@boxcricket.dev
# Generate hash: npx ts-node -e "require('argon2').hash('YourPassword').then(console.log)"
SUPER_ADMIN_PASSWORD_HASH=REPLACE_ME
SUPER_ADMIN_NAME=Platform Admin

# ── Owner OAuth ──────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3002/auth/google/callback

# ── Booking defaults ─────────────────────────────────────────────────────────
SLOT_HOLD_TTL_MINUTES=8
ADVANCE_PERCENT=50
CANCEL_FULL_REFUND_HOURS=24
CANCEL_HALF_REFUND_HOURS=6

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
PROMETHEUS_METRICS_ENABLED=true

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_OTP_PER_PHONE_PER_15MIN=3
RATE_LIMIT_OTP_PER_IP_PER_HOUR=10
RATE_LIMIT_API_PER_USER_PER_MIN=120
RATE_LIMIT_API_PER_IP_PER_MIN=300
